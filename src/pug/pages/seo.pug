extends ../layouts/layout-swiper.pug

block content
	.page-column
		include ../sections/_header.pug
		//==== MAIN =====
		main.inner-main
			include ../sections/_promo-seo.pug
			include ../sections/_parallax-seo.pug
			//- include ../sections/_seo-map.pug
			//- include ../sections/_what-seo-animate.pug
			include ../sections/_stage-line.pug
			include ../sections/_technology.pug
			//- include ../sections/_what-seo.pug
			include ../sections/_seo-stages.pug
			include ../sections/_our-mission.pug
			//- include ../sections/_our-portfolio.pug
			include ../sections/_our-portfolio2.pug
			include ../sections/_team.pug
			include ../sections/_tariff.pug
			include ../sections/_quiz.pug
			include ../sections/_geo.pug
			include ../sections/_our-clients.pug
			include ../sections/_highlight.pug
			
			include ../sections/_review.pug
			include ../sections/_services.pug
			include ../sections/_feedback.pug

			
		//==== FOOTER =====
		include ../sections/_footer.pug

		//POpUP по клику на кнопку тарифа
		.modal-frame(data-modal="tariff-card")
			.modal-frame-wrapper
				.modal-frame-content
					//====FORM=====
					.modal-frame-form
						.modal-title Оставьте заявку
						//===== FORM =====
						form.modal-form.grid-form(action="" method="method")
							.form-item
								input.form-input(type="text" placeholder="Имя")
								span.form-input-state
							.form-item
								input.form-input.phone(type="tel" placeholder="+7 (     )")
								span.form-input-state
							.form-item
								input.form-input.phone(type="email" placeholder="Email")
								span.form-input-state
							
							//===== btn-group =====
							.form-btn-group.flex-column
								button.btn-accent.btn-overlay.w-100(type="submit")
									span Отправить
								p.accept-terms  Нажав на кнопку, соглашаюсь на обработку #[a(href="#!") персональных данных]
								

					//====SUCCESS MESSAGE=====
					.modal-success
						p Сообщение успешно отправлено!|
						p Скоро с вами свяжуться наши специалисты 🤍
	
block variables
	-var title = "SEO";
