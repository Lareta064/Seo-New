header.header.header--seo#header
	.container
		.header-container
			a(href="#!").logo
				svg.svg-logo
					use(href='./img/sprite.svg#svg-logo')
			//======nav menu ======
			.main-menu-wrapper#header-menu
				.main-menu
					ul.menu-list
						li.menu-item.has-drop-menu
							a.menu-link(href="#!") Услуги
							.drop-menu-wrapper
								.drop-menu__grid
									ul.drop-menu-list
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #FF562F;").drop-menu__link Контекстная реклама
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #3A7FF5;").drop-menu__link Таргетированная реклама
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #FFFFFF;").drop-menu__link Комплексный маркетинг
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #F98836;").drop-menu__link SEO продвижение 
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #B0E669;").drop-menu__link Веб-дизайн / Иллюстрация
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #BF8DFF;").drop-menu__link Разработка сайтов
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #89B5FF;").drop-menu__link SMM
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #FFCD6D;").drop-menu__link SERM
											
										li.drop-menu-list__item
											a(href="#" style="--hover-color: #2AC6C3;").drop-menu__link Видео продакшн
											
									//right column
									.drop-menu-box
										img(src='./img/placeholder.webp', srcset='./img/placeholder@2x.webp 2x' width='402' height='248' loading='lazy' alt='img')
						
						li.menu-item
							a.menu-link(href="#!") Кейсы
						li.menu-item
							a.menu-link(href="#!") О компании
						li.menu-item
							a.menu-link(href="#!") Блог
						li.menu-item
							a.menu-link(href="#!") Контакты
						
					form.mobile-city-select
						.dropdown.dropdown-city
							button.dropdown__button(type="button") Санкт-Петербург
							
							.dropdown__list
								ul
									li.dropdown__list-item(data-value="Казань") Казань
									li.dropdown__list-item(data-value="Санкт-Петербург") Санкт-Петербург
									li.dropdown__list-item(data-value="Москва") Москва
									li.dropdown__list-item(data-value="Минск") Минск
									li.dropdown__list-item(data-value="Дубай") Дубай

								//==== в этот скрытый инпут в качестве value  выводится значение из data-value у.dropdown__list-item ===
								input.dropdown__input-hidden(type="hidden", name="")
								
								//search-input
								.search-form-item
									input.search-form-input(type="text" placeholder="Ваш город"  name="")
									button.search-btn(type="submit")
										svg.svg-search
											use(href='./img/sprite.svg#svg-search')


			//====== right content ======
			.phone-contacts.city-popup-block
				a(href="tel:+79006566903").phone-link +7 900 656 69 03
					svg.svg-phone.phone-link__icon
						use(href='./img/sprite.svg#svg-phone')

				button.open-city-popup.user-city(type="button"  data-btn="city-popup") г. 
					span.user-city-name Санкт-Петербург
				
				//city-popup
				.modal-frame.modal-city(data-modal="city-popup")
					
					.modal-frame-wrapper
						
						.modal-frame-content
							//close modal
							button.btn-close(type="button" data-close)
								svg.svg-cross
									use(href='./img/sprite.svg#svg-cross')
							//form
							form.select-city.search-form
								.search-form-item
									input.search-form-input(type="text" placeholder="Ваш город")
									button.search-btn(type="submit")
										svg.svg-search
											use(href='./img/sprite.svg#svg-search')
								
								//city list
								.search-city-list
									button.search-city-item(type="button" data-value="Казань") Казань
									button.search-city-item(type="button" data-value="Санкт-Петербург") Санкт-Петербург
									button.search-city-item(type="button" data-value="Москва") Москва
									button.search-city-item(type="button" data-value="Минск") Минск
									button.search-city-item(type="button" data-value="Дубай") Дубай
							
			
			//header button
			button.btn-outline(type="button" data-btn="basic-popup") Заявка
			//====== menu-toggle =====
			button.menu-toggle#menu-toggle
				span